extends "res://tests/test_case.gd"

## Differential replay of the TypeScript math oracle.
## Fixtures are generated by scripts/gen-math-fixtures.ts (npx tsx). Every
## expected value comes from the frozen legacy oracle, not from this port.

const FIXTURE_DIR: String = "res://tests/fixtures/math/"
const STATS_PATH: String = "res://scripts/core/math/stats.gd"
const FORMULA_PATH: String = "res://scripts/core/math/formula.gd"
const DAMAGE_PATH: String = "res://scripts/core/math/damage.gd"

var _stats: Object
var _formula: Object
var _damage: Object

func run(_tree: SceneTree) -> bool:
	_stats = (load(STATS_PATH) as Script).new()
	_formula = (load(FORMULA_PATH) as Script).new()
	_damage = (load(DAMAGE_PATH) as Script).new()
	if not check(_stats != null and _formula != null and _damage != null, "differential: math implementations missing"):
		return false
	_run_conditions()
	_run_stats()
	_run_conversions()
	_run_formula()
	_run_damage()
	return failure_count == 0

func _load(file_name: String) -> Variant:
	var path: String = FIXTURE_DIR + file_name
	var file: FileAccess = FileAccess.open(path, FileAccess.READ)
	if file == null:
		check(false, "differential: cannot open fixture %s" % path)
		return null
	var text: String = file.get_as_text()
	file.close()
	var parsed: Variant = JSON.parse_string(text)
	if parsed == null:
		check(false, "differential: invalid JSON in %s" % path)
	return parsed

func _darr(value: Variant) -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	if value is Array:
		for element: Variant in value:
			if element is Dictionary:
				out.append(element)
	return out

func _typed_args(args: Variant) -> Array:
	var out: Array = []
	if not args is Array:
		return out
	for arg: Variant in args:
		if arg is Array:
			var numeric: bool = true
			for element: Variant in arg:
				if not (element is float or element is int):
					numeric = false
					break
			if numeric:
				var typed: Array[float] = []
				for element: Variant in arg:
					typed.append(float(element))
				out.append(typed)
				continue
		out.append(arg)
	return out

func _near(actual: float, expected: float) -> bool:
	return absf(actual - expected) <= 0.000000001 * maxf(1.0, absf(expected))

func _compare(actual: Variant, expected: Variant, label: String, skip_explanation: bool = false) -> void:
	if expected == null:
		check(actual == null, "%s: expected null, got %s" % [label, str(actual)])
		return
	if expected is Dictionary:
		if not check(actual is Dictionary, "%s: expected Dictionary" % label):
			return
		for key: Variant in (expected as Dictionary).keys():
			# localizedExplanation is cosmetic UI text. Godot str(float) rounds to 6
			# decimals while JS uses shortest round-trip, so exact explanation-text
			# parity is deferred to the Lab UI stage. The computational trace contract
			# (operation/stage/exactValue/inputs/source/unit/children/flags) is compared.
			if skip_explanation and str(key) == "localizedExplanation":
				continue
			_compare((actual as Dictionary).get(key), (expected as Dictionary)[key], "%s.%s" % [label, key], skip_explanation)
	elif expected is Array:
		if not check(actual is Array, "%s: expected Array" % label):
			return
		var actual_array: Array = actual
		var expected_array: Array = expected
		if not check(actual_array.size() == expected_array.size(), "%s: array size %d != %d" % [label, actual_array.size(), expected_array.size()]):
			return
		for i: int in range(expected_array.size()):
			_compare(actual_array[i], expected_array[i], "%s[%d]" % [label, i], skip_explanation)
	elif expected is String and (expected == "Infinity" or expected == "-Infinity" or expected == "NaN"):
		var actual_float: float = float(actual) if actual != null else NAN
		var matches: bool = false
		if expected == "Infinity":
			matches = is_inf(actual_float) and actual_float > 0.0
		elif expected == "-Infinity":
			matches = is_inf(actual_float) and actual_float < 0.0
		else:
			matches = is_nan(actual_float)
		check(matches, "%s: non-finite %s != %s" % [label, str(actual), str(expected)])
	elif expected is String:
		check(actual is String and str(actual) == str(expected), "%s: text '%s' != '%s'" % [label, str(actual), str(expected)])
	elif expected is bool:
		check(actual is bool and bool(actual) == bool(expected), "%s: bool %s != %s" % [label, str(actual), str(expected)])
	elif actual == null:
		check(false, "%s: expected number %s, got null (missing field)" % [label, str(expected)])
	else:
		check(_near(float(actual), float(expected)), "%s: value %s != %s" % [label, str(actual), str(expected)])

func _run_conditions() -> void:
	var cases: Variant = _load("condition_cases.json")
	if not cases is Array:
		return
	for index: int in range((cases as Array).size()):
		var c: Dictionary = (cases as Array)[index]
		var condition: Dictionary = c.get("condition", {})
		var context: Dictionary = c.get("context", {})
		var label: String = "condition[%d]" % index
		var actual_eval: bool = bool(_stats.call("eval_condition", condition, context))
		check(actual_eval == bool(c.get("expectedEval", false)), "%s: eval %s != %s (%s)" % [label, str(actual_eval), str(c.get("expectedEval")), JSON.stringify(condition)])
		var actual_text: String = str(_stats.call("condition_text", condition))
		check(actual_text == str(c.get("expectedText", "")), "%s: text '%s' != '%s'" % [label, actual_text, str(c.get("expectedText", ""))])

func _run_stats() -> void:
	var cases: Variant = _load("stat_cases.json")
	if not cases is Array:
		return
	for index: int in range((cases as Array).size()):
		var c: Dictionary = (cases as Array)[index]
		var bundle: Dictionary = _stats.call("bundle", _darr(c.get("mods", [])), _darr(c.get("conversions", [])))
		var result: Dictionary = _stats.call("compute_stat", str(c.get("statId", "")), bundle, c.get("context", {}), {}, "")
		var label: String = "stat[%s]" % str(c.get("name", index))
		check(_near(float(result.get("value", 0.0)), float(c.get("expectedValue", 0.0))), "%s: value %s != %s" % [label, str(result.get("value")), str(c.get("expectedValue"))])
		if c.has("expectedTrace"):
			_compare(result.get("trace", {}), c.get("expectedTrace", {}), "%s.trace" % label, true)

func _run_conversions() -> void:
	var cases: Variant = _load("conversion_cases.json")
	if not cases is Array:
		return
	for index: int in range((cases as Array).size()):
		var c: Dictionary = (cases as Array)[index]
		var label: String = "conversion[%s]" % str(c.get("name", index))
		var conversions: Array[Dictionary] = _darr(c.get("conversions", []))
		var ordering: Dictionary = _stats.call("conversion_order", conversions)
		if bool(c.get("expectCycle", false)):
			check(not bool(ordering.get("ok", true)), "%s: cycle was not rejected" % label)
			check(str(ordering.get("error", "")).begins_with(str(c.get("expectedErrorPrefix", "Цикл конверсий"))), "%s: wrong cycle error '%s'" % [label, str(ordering.get("error", ""))])
			continue
		if not check(bool(ordering.get("ok", false)), "%s: ordering failed: %s" % [label, str(ordering.get("error", ""))]):
			continue
		var expected_order: Array = c.get("expectedOrder", [])
		var actual_order: Array = ordering.get("order", [])
		if c.has("expectedOrder"):
			if check(actual_order.size() == expected_order.size(), "%s: order size mismatch" % label):
				for i: int in range(expected_order.size()):
					check(str(actual_order[i]) == str(expected_order[i]), "%s: order[%d] %s != %s" % [label, i, str(actual_order[i]), str(expected_order[i])])
		var bundle: Dictionary = _stats.call("bundle", _darr(c.get("mods", [])), conversions)
		var context: Dictionary = c.get("context", {})
		var results: Dictionary = _stats.call("resolve_stats", bundle, context)
		var sheet: Dictionary = _stats.call("sheet_of", results)
		_compare(sheet, c.get("expectedSheet", {}), "%s.sheet" % label)
		if c.has("expectedEmptySheet"):
			_compare(_stats.call("empty_sheet"), c.get("expectedEmptySheet", {}), "%s.empty" % label)

func _run_formula() -> void:
	var cases: Variant = _load("formula_cases.json")
	if not cases is Array:
		return
	for index: int in range((cases as Array).size()):
		var c: Dictionary = (cases as Array)[index]
		var fn: String = str(c.get("fn", ""))
		var args: Array = _typed_args(c.get("args", []))
		var actual: Variant = _formula.callv(fn, args)
		_compare(actual, c.get("expected"), "formula[%d:%s]" % [index, fn])

func _run_damage() -> void:
	var cases: Variant = _load("damage_cases.json")
	if not cases is Array:
		return
	for index: int in range((cases as Array).size()):
		var c: Dictionary = (cases as Array)[index]
		var fn: String = str(c.get("fn", ""))
		var args: Array = c.get("args", [])
		var actual: Variant = _damage.callv(fn, args)
		_compare(actual, c.get("expected"), "damage[%d:%s]" % [index, fn], true)